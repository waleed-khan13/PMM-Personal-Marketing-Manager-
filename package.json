{
  "name": "localgrowth-os",
  "version": "0.6.0",
  "private": true,
  "description": "Open-source, localhost-only AI growth automation for content, leads, and SEO.",
  "license": "MIT",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "dev:api": "uv run --project backend uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "backend:sync": "uv sync --project backend",
    "backend:test": "uv run --directory backend pytest",
    "backend:lint": "uv run --directory backend ruff check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm backend:lint && pnpm backend:test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
