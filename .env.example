# Browser-facing URL. Use your public HTTPS URL when enabling Telegram callbacks.
APP_URL=http://localhost:3000

# Runtime identity and native bind address.
DEPLOYMENT_MODE=local_trusted
LOCALGROWTH_HOST=127.0.0.1

# Durable JSON database and encryption key directory.
# Native default: ./data
# Docker Compose sets this to /app/data and mounts a named volume there.
LOCALGROWTH_DATA_DIR=./data

# Optional override for the secure Telegram webhook secret.
# When blank, the dashboard generates, encrypts, and registers a secret automatically.
TELEGRAM_WEBHOOK_SECRET=

# AI provider and Telegram credentials are configured in the dashboard and encrypted at rest.
